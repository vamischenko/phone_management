###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=change_me_to_random_32chars_string
###< symfony/framework-bundle ###

###> doctrine/doctrine-bundle ###
DATABASE_URL="postgresql://${POSTGRES_USER:-app}:${POSTGRES_PASSWORD:-secret}@${POSTGRES_HOST:-postgres}:5432/${POSTGRES_DB:-phone_management}?serverVersion=16&charset=utf8"
###< doctrine/doctrine-bundle ###

###> routing ###
DEFAULT_URI=http://localhost:8080
###< routing ###

###> redis ###
REDIS_URL=redis://${REDIS_HOST:-redis}:6379
###< redis ###

###> docker ###
POSTGRES_DB=phone_management
POSTGRES_USER=app
POSTGRES_PASSWORD=secret
POSTGRES_HOST=postgres
REDIS_HOST=redis
NGINX_PORT=8080
###< docker ###
